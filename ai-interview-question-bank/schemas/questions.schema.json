{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/questions.schema.json",
  "title": "AI 产品面试母题库",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "originalQuestionCount", "questions"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "originalQuestionCount": { "type": "integer", "minimum": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mainCategory", "businessCategories", "corePoints", "tags", "similarQuestions", "sources", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 5 },
        "mainCategory": { "type": "string", "minLength": 2 },
        "businessCategories": { "$ref": "#/$defs/nonEmptyStrings" },
        "corePoints": { "$ref": "#/$defs/nonEmptyStrings" },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["company", "companyStyle", "interviewStage", "frequency", "companySpecific"],
          "properties": {
            "company": { "$ref": "#/$defs/nonEmptyStrings" },
            "companyStyle": { "$ref": "#/$defs/nonEmptyStrings" },
            "interviewStage": { "$ref": "#/$defs/nonEmptyStrings" },
            "frequency": { "enum": ["S", "A", "B", "C"] },
            "companySpecific": { "enum": ["yes", "no", "partial"] }
          }
        },
        "similarQuestions": { "$ref": "#/$defs/nonEmptyStrings" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document", "reference"],
            "properties": {
              "document": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date" }
      }
    }
  }
}
